{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "id": "career-remotive",
  "version": "1.0.0",
  "description": "Remote-jobs feed from remotive.com's public API (free, no credentials — no secret slots by design).",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "capabilities": [
    "net",
    "sync"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "title": "Category slug",
        "description": "Board category filter, e.g. software-dev (empty = all)",
        "maxLength": 60
      },
      "max_items": {
        "type": "number",
        "title": "Max items per sync",
        "default": 100,
        "minimum": 1,
        "maximum": 500
      }
    }
  },
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "Remotive remote jobs",
        "summary": "Remote job listings from Remotive's public API — free, no credentials, no secret slots."
      }
    }
  },
  "domains": [
    "remotive.com"
  ],
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ],
  "docs": "docs/docs-tree.json"
}
