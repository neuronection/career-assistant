# ==== Career Assistant (Career Assistant) ====
APP_NAME=Career Assistant
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- Database (dev container maps host 5433 -> container 5432) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=career
POSTGRES_TEST_DB=career_test
POSTGRES_USER=career
POSTGRES_PASSWORD=career_dev_pw
DATABASE_URL=postgresql+asyncpg://career:career_dev_pw@127.0.0.1:5433/career

# --- Redis (reserved for future worker split) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Security ---
# Dev-only secret. ALWAYS override with a long random value outside dev.
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Transitory single-user mode: no login/register UI — requests without a
# token resolve to a lazily-created default user (admin). Set to false to
# restore the classic JWT login flow.
SINGLE_USER_MODE=true
DEFAULT_USER_EMAIL=default@local.app

# --- AI ---
# AI providers/models/task assignments are configured exclusively in the app:
# Settings → AI Configuration (stored in the database). No AI_* env vars.
# The built-in mock provider is OPT-IN: set MOCK_AI=1 (or start the dev
# group with ./scripts/run-dev.sh --mock-ai) to auto-provision it so
# everything works offline. Without it, dev AI endpoints return 503 until
# a real provider is configured in the UI. Production ignores MOCK_AI —
# the mock provider is blocked there regardless.
# MOCK_AI=1

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# --- Rate limiting (requests per minute; 0 disables a bucket) ---------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=30
DEFAULT_RATE_LIMIT=240

# --- Login brute-force lockout ----------------------------------------------
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# --- Passwords ----------------------------------------------------------------
PASSWORD_MIN_LENGTH=10
