# ==== Career Assistant (MatchJobAssistant) ====
APP_NAME=Career Assistant
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- Database (dev container maps host 5433 -> container 5432) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=matchjob
POSTGRES_TEST_DB=matchjob_test
POSTGRES_USER=matchjob
POSTGRES_PASSWORD=matchjob_dev_pw
DATABASE_URL=postgresql+asyncpg://matchjob:matchjob_dev_pw@127.0.0.1:5433/matchjob

# --- Redis (reserved for future worker split) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Security ---
# Dev-only secret. ALWAYS override with a long random value outside dev.
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- AI ---
# AI providers/models/task assignments are configured exclusively in the app:
# Settings → AI Configuration (stored in the database). No AI_* env vars.
# In APP_ENV=development a built-in mock provider is auto-provisioned so
# everything works offline. Production starts unconfigured (503s) until an
# admin adds a real provider via the UI.

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# --- Rate limiting (requests per minute; 0 disables a bucket) ---------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=30
DEFAULT_RATE_LIMIT=240

# --- Login brute-force lockout ----------------------------------------------
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# --- Passwords ----------------------------------------------------------------
PASSWORD_MIN_LENGTH=10
