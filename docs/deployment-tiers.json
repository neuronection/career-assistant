{
  "version": 1,
  "product": "career",
  "tiers": [
    "desktop",
    "T1",
    "T2"
  ],
  "profiles": [
    "household",
    "clinic"
  ],
  "limits": {
    "min_ram_gb": 4
  },
  "probes": {
    "liveness": "/health",
    "readiness": "/ready"
  },
  "backupPolicy": {
    "offhost": true,
    "encrypted": "when-shared"
  },
  "paths": [
    {
      "path": "desktop",
      "support": "supported",
      "verified": "v0.17.0-rc.2"
    },
    {
      "path": "compose-selfhosted",
      "support": "supported",
      "verified": "v0.17.0-rc.2"
    },
    {
      "path": "cloud-vm",
      "support": "best-effort",
      "verified": null
    },
    {
      "path": "managed-db",
      "support": "best-effort",
      "verified": null
    },
    {
      "path": "terraform",
      "support": "best-effort",
      "verified": null
    }
  ]
}
