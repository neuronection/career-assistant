# Caddyfile for the optional TLS proxy profile (automatic HTTPS via Let's Encrypt).
# Used only with: docker compose -f docker/docker-compose.prod.yml --profile proxy up -d

{$CA_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8100 {
		# SSE/streaming-friendly: flush immediately, never buffer.
		flush_interval -1
	}

	request_body {
		# Keep in sync with MAX_UPLOAD_MB.
		max_size 64MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
