# Per-purpose key family (identity-auth §8) — pinned so every xdist
# worker and migration run encrypts/verifies under the same test keys.
CAREER_SESSION_KEY=test-session-key-0123456789abcdefghijklmnopqrstuv
CAREER_REFRESH_KEY=test-refresh-key-0123456789abcdefghijklmnopqrstuv
CAREER_DATA_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY
UPLOAD_DIR=tests/_uploads
DATA_DIR=tests/_data
RATE_LIMIT_ENABLED=false
SCHEDULER_ENABLED=false
AI_RATE_LIMIT=0
MOCK_AI=1
