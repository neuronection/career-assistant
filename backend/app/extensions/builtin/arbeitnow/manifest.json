{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "id": "career-arbeitnow",
  "version": "1.0.0",
  "description": "Live German/European job board through the public job-board-api (free, no credentials — no secret slots by design).",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "capabilities": [
    "net",
    "sync"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "title": "Tag filter",
        "description": "Only keep rows carrying at least one of these tags (empty = all)",
        "maxItems": 16,
        "items": {
          "type": "string"
        },
        "default": []
      },
      "max_items": {
        "type": "number",
        "title": "Max items per sync",
        "default": 100,
        "minimum": 1,
        "maximum": 300
      }
    }
  },
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "Arbeitnow job board",
        "summary": "German and European job listings from Arbeitnow's public API — free, no credentials, no secret slots."
      }
    }
  },
  "domains": [
    "www.arbeitnow.com"
  ],
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ],
  "docs": "docs/docs-tree.json"
}
