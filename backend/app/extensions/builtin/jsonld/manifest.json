{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "id": "career-jsonld",
  "version": "1.0.0",
  "description": "Postings extracted from schema.org/JobPosting JSON-LD structured data.",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "capabilities": [
    "sync"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "Page URL",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required": [
      "url"
    ]
  },
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "schema.org JobPosting page",
        "summary": "Postings extracted from schema.org/JobPosting JSON-LD structured data."
      }
    }
  },
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ]
}
