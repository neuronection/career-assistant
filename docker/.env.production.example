# Career Assistant — production environment template.
# Copy to docker/.env (same directory as docker-compose.prod.yml) and edit.

# --- Required secrets -------------------------------------------------------
# Per-purpose key family (identity-auth §8): three INDEPENDENT per-instance
# secrets — never derived from each other. Generate each one separately:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CAREER_SESSION_KEY=change-me-session-key
CAREER_REFRESH_KEY=change-me-refresh-key
CAREER_DATA_KEY=change-me-data-key

# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me-too

# --- Database (sane defaults) ----------------------------------------------
POSTGRES_DB=neuronection_career
POSTGRES_USER=neuronection_career_owner

# --- App --------------------------------------------------------------------
# Host port the app is published on (container always listens on 8100).
API_PORT=8100
MAX_UPLOAD_MB=25
# Rightmost X-Forwarded-For hops trusted for per-IP limits (identity-auth
# §7/§16). The compose stacks sit behind the bundled nginx or your own
# reverse proxy, so 1 is the right value; 0 trusts no forwarded header.
CAREER_TRUSTED_PROXY_COUNT=1

# Comma-separated extra allowed origins. Leave empty when the SPA is served
# by the app itself (same-origin). Example for a split setup:
# CORS_ORIGINS=https://career.example.com

# --- Optional: TLS reverse proxy (--profile proxy) --------------------------
# The public hostname pointing at this machine (A/AAAA record).
# CA_DOMAIN=career.example.com
