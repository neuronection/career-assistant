# ==== Career Assistant (Career Assistant) ====
APP_NAME=Career Assistant
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- Database (dev container maps host 5433 -> container 5432) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=neuronection_career
POSTGRES_TEST_DB=neuronection_career_test
POSTGRES_USER=neuronection_career_owner
POSTGRES_PASSWORD=career_dev_pw
DATABASE_URL=postgresql+asyncpg://neuronection_career_owner:career_dev_pw@127.0.0.1:5433/neuronection_career

# --- Redis (reserved for future worker split) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Security & identity (family auth contract, ADR-0013) ---
# Per-purpose key family (identity-auth §8; three INDEPENDENT per-instance
# secrets — nothing is derived from anything else, and DATA_KEY never
# signs tokens):
#   CAREER_SESSION_KEY   signs session (access) JWTs
#   CAREER_REFRESH_KEY   signs refresh JWTs
#   CAREER_DATA_KEY      Fernet-encrypts secrets at rest (never signs)
# Pin all three (production servers MUST; partial pins fail closed) or
# none — then a 0600 auth_keys.json generates in the data dir (desktop).
# Generate each with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# CAREER_DATA_KEY must stay 32-byte urlsafe-base64 (the command above is);
# a Fernet key works too. The legacy JWT-derived Fernet is retired —
# migration 0044 drains its ciphertext (AI provider keys are wiped and
# re-entered in Settings → AI Configuration).
# CAREER_SESSION_KEY=
# CAREER_REFRESH_KEY=
# CAREER_DATA_KEY=

# Instance access modes (identity-auth §4) — INIT-ONLY: consumed when the
# database is empty; afterwards instance_settings is authoritative and
# post-init flips are ignored with a loud warning. Desktop entrypoints
# (python -m careerassistant) default to `open` (no login, DIM owner);
# server/docker runs `authenticated` (login/register; first user = admin).
# CAREER_AUTH_MODE=authenticated
# CAREER_DEMO_MODE=                # demo instances (P3e); production aborts on true

# Auth behavior (identity-auth §16) — read at boot from the process
# environment or this file (OS environment wins):
# CAREER_REGISTRATION_ENABLED=true
#   ^ self-service registration switch (per deployment): false ⇒
#     POST /auth/register answers 403, the login screen hides its register
#     action, and admins create accounts from Settings → Users instead.
# CAREER_AUTH_ACCESS_TTL_MINUTES=60
# CAREER_AUTH_REFRESH_TTL_DAYS=7
# CAREER_AUTH_REFRESH_ABSOLUTE_DAYS=30
# CAREER_AUTH_LOCKOUT_THRESHOLD=5
# CAREER_AUTH_LOCKOUT_MINUTES=15
# CAREER_TRUSTED_PROXY_COUNT=0
# CAREER_COOKIE_SECURE=false       # true behind TLS (__Host-nx_access)

# --- AI ---
# AI providers/models/task assignments are configured exclusively in the app:
# Settings → AI Configuration (stored in the database). No AI_* env vars.
# The built-in mock provider is OPT-IN: set MOCK_AI=1 (or start the dev
# group with ./scripts/run-dev.sh --mock-ai) to auto-provision it so
# everything works offline. Without it, dev AI endpoints return 503 until
# a real provider is configured in the UI. Production ignores MOCK_AI —
# the mock provider is blocked there regardless.
# MOCK_AI=1

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# --- Rate limiting (§16 CAREER_RATELIMIT_*; requests per minute, 0
#     disables a bucket — the unprefixed names still work) ---
CAREER_RATELIMIT_ENABLED=true
CAREER_RATELIMIT_AUTH=10            # /auth/login + /auth/register per IP (and the kit's auth limiter)
CAREER_RATELIMIT_AUTH_EMAIL=30      # per-email auth attempts (kit)
CAREER_RATELIMIT_AI=30
CAREER_RATELIMIT_MCP=120
CAREER_RATELIMIT_DEFAULT=240
