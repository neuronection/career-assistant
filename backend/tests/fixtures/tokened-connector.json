{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "id": "career-tokened",
  "version": "1.0.0",
  "description": "Test connector with a secret slot (needs-secret path).",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "capabilities": ["sync", "secrets"],
  "configSchema": {
    "type": "object",
    "properties": {
      "board": {"type": "string"},
      "token": {"type": "string", "x-secret": true}
    },
    "required": ["board"]
  },
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {"type": "string", "title": "External id"},
      "title": {"type": "string", "title": "Title"},
      "url": {"type": "string", "title": "URL"}
    },
    "required": ["external_id", "title"]
  },
  "supportsIncremental": false,
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "Tokened",
        "summary": "Test connector with a secret slot."
      }
    }
  }
}
