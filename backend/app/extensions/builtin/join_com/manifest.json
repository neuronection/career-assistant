{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ],
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "docs": "docs/docs-tree.json",
  "id": "career-join-com",
  "version": "1.0.0",
  "description": "JOIN.com public company job API (free, no credentials — no secret slots by design).",
  "capabilities": [
    "net",
    "sync"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "company_id": {
        "type": "number",
        "title": "JOIN company id",
        "description": "The numeric company id used by JOIN's public company API",
        "minimum": 1
      },
      "company_slug": {
        "type": "string",
        "title": "Company slug",
        "description": "The slug in the public careers URL (join.com/companies/<slug>)",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "page_size": {
        "type": "number",
        "title": "Page size",
        "description": "The public API caps pageSize at 5",
        "default": 5,
        "minimum": 1,
        "maximum": 5
      },
      "max_items": {
        "type": "number",
        "title": "Max items per sync",
        "default": 50,
        "minimum": 1,
        "maximum": 200
      }
    },
    "required": [
      "company_id",
      "company_slug"
    ]
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "JOIN.com careers feed",
        "summary": "Open roles from a JOIN.com company career page — free, no credentials, no secret slots."
      }
    }
  },
  "domains": [
    "join.com"
  ]
}
