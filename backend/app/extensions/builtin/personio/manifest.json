{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ],
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "docs": "docs/docs-tree.json",
  "id": "career-personio",
  "version": "1.0.0",
  "description": "Personio per-tenant careers feed (public XML, free, no credentials — no secret slots by design).",
  "capabilities": [
    "net",
    "sync"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "tenant": {
        "type": "string",
        "title": "Career-site tenant",
        "description": "The subdomain before jobs.personio.de (e.g. acme for acme.jobs.personio.de)",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "language": {
        "type": "string",
        "title": "Feed language",
        "default": "en",
        "maxLength": 8
      },
      "max_items": {
        "type": "number",
        "title": "Max items per sync",
        "default": 100,
        "minimum": 1,
        "maximum": 300
      }
    },
    "required": [
      "tenant"
    ]
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "Personio careers feed",
        "summary": "Open roles from a Personio career site's public XML feed — free, no credentials, no secret slots."
      }
    }
  },
  "domains": [
    "*.jobs.personio.de"
  ]
}
