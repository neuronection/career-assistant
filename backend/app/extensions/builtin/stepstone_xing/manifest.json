{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ],
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "docs": "docs/docs-tree.json",
  "id": "career-stepstone-xing",
  "version": "1.0.0",
  "description": "StepStone / Xing saved-search job alerts over RSS 2.0 (personal alert URL kept in a sealed secret slot).",
  "capabilities": [
    "sync",
    "secrets"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "title": "Board",
        "enum": [
          "stepstone",
          "xing"
        ],
        "default": "stepstone"
      },
      "feed_url": {
        "type": "string",
        "title": "Personal RSS alert URL",
        "description": "The RSS URL from a signed-in StepStone or Xing job alert — it is personal, so it is stored as a sealed secret slot",
        "maxLength": 1000,
        "x-secret": true
      },
      "max_items": {
        "type": "number",
        "title": "Max items per sync",
        "default": 100,
        "minimum": 1,
        "maximum": 300
      }
    },
    "required": [
      "provider"
    ]
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "StepStone / Xing job alerts (RSS)",
        "summary": "Your StepStone or Xing saved-search job alert as an RSS source — the personal alert URL is sealed, never stored in config."
      }
    }
  }
}
