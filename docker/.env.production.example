# Career Assistant — production environment template.
# Copy to docker/.env (same directory as docker-compose.prod.yml) and edit.

# --- Required secrets -------------------------------------------------------
# Per-purpose key family (identity-auth §8): three INDEPENDENT per-instance
# secrets — never derived from each other. Generate each one separately:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Pin all three or none (identity-auth §8) — generate per deploy:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholders below only satisfy the compose required-variable guards
# (`${VAR:?…}`) so `docker compose config` validates the example as-is —
# replace every one of them before a real deploy.
CAREER_SESSION_KEY=replace-with-generated-session-key
CAREER_REFRESH_KEY=replace-with-generated-refresh-key
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAREER_DATA_KEY=replace-with-generated-fernet-key

# Legacy alias only; compose bootstraps the DB with CAREER_DB_OWNER_PASSWORD.
# POSTGRES_PASSWORD=change-me-too

# --- Database credential split (ADR-0064) ------------------------------------
# Two roles, two secrets: the owner (DDL/migrations, used ONLY by the one-shot
# `migrate` service) and the app role (DML-only, used by the app). Generate
# each separately — both are required by compose and must differ; reusing
# one password defeats the least-privilege split.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
CAREER_DB_OWNER_PASSWORD=change-me-owner-password
CAREER_DB_PASSWORD=change-me-app-password
# The app role name (family naming; rarely changed).
# CAREER_DB_APP_USER=neuronection_career_app

# --- Database (sane defaults) ----------------------------------------------
POSTGRES_DB=neuronection_career
POSTGRES_USER=neuronection_career_owner

# --- App --------------------------------------------------------------------
# Host port the app is published on (container always listens on 8100).
CAREER_API_PORT=8100
CAREER_MAX_UPLOAD_MB=25
# Data-export ceiling (1-1024 MB): one archive bundles every document a user
# owns, so it is independent of the per-upload cap. Leave the 1024 default
# unless temp-space/disk policy needs a lower bound.
# CAREER_EXPORT_MAX_MB=1024
# Rightmost X-Forwarded-For hops trusted for per-IP limits (identity-auth
# §7/§16). The compose stacks sit behind the bundled nginx or your own
# reverse proxy, so 1 is the right value; 0 trusts no forwarded header.
CAREER_TRUSTED_PROXY_COUNT=1

# Cookie `Secure` derives from the public scheme (plan 64 §1.6 / ADR-0062 §9):
# set CAREER_PUBLIC_URL to the URL users type — `https://…` pins Secure,
# `http://…` (LAN/VPN) keeps login working. No domain yet? Set CAREER_TLS=1
# once TLS is on. An explicit CAREER_COOKIE_SECURE=true|false overrides both.
# CAREER_PUBLIC_URL=https://career.example.com
# CAREER_TLS=0
# CAREER_COOKIE_SECURE=

# Comma-separated extra allowed origins. Leave empty when the SPA is served
# by the app itself (same-origin). Example for a split setup:
# CAREER_CORS_ORIGINS=https://career.example.com

# --- Family object storage (ADR-0057) ---------------------------------------
# Leave everything commented for a local-volume self-host deployment.
# A cloud profile uses object storage only; combine docker-compose.cloud.yml
# and set one provider block below. Leave CAREER_OBJECT_STORAGE_MAX_MB unset
# (career's 25 MB host ceiling); do not pin 100 here.
#
#   docker compose -f docker/docker-compose.prod.yml \
#                  -f docker/docker-compose.cloud.yml up -d
#
# AWS S3 — instance/task role (recommended; no static keys in env):
# CAREER_CLOUD_PROFILE=aws
# CAREER_OBJECT_STORAGE_BACKEND=s3
# CAREER_S3_BUCKET=neuronection-career-prod
# CAREER_S3_REGION=eu-central-1
# CAREER_S3_PREFIX=prod/
# CAREER_S3_SSE=aws:kms
# CAREER_S3_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/...
#
# AWS S3 — static keys (prefer the role; rotate and never commit):
# CAREER_CLOUD_PROFILE=aws
# CAREER_OBJECT_STORAGE_BACKEND=s3
# CAREER_S3_BUCKET=neuronection-career-prod
# CAREER_S3_REGION=eu-central-1
# CAREER_S3_ACCESS_KEY_ID=...
# CAREER_S3_SECRET_ACCESS_KEY=...
# CAREER_S3_SSE=AES256
# CAREER_S3_PREFIX=prod/
#
# S3-compatible endpoint (MinIO, R2, B2, Wasabi, Ceph; SSE is required
# under a cloud profile):
# CAREER_CLOUD_PROFILE=cloud
# CAREER_OBJECT_STORAGE_BACKEND=s3
# CAREER_S3_BUCKET=career
# CAREER_S3_ENDPOINT_URL=https://minio.example.com
# CAREER_S3_PATH_STYLE=true
# CAREER_S3_ACCESS_KEY_ID=...
# CAREER_S3_SECRET_ACCESS_KEY=...
# CAREER_S3_SSE=AES256
# CAREER_S3_PREFIX=prod/
#
# Azure Blob — managed identity (no secret in env):
# CAREER_CLOUD_PROFILE=azure
# CAREER_OBJECT_STORAGE_BACKEND=azure_blob
# CAREER_AZURE_STORAGE_CONTAINER=career-data
# CAREER_AZURE_STORAGE_ACCOUNT_URL=https://career.blob.core.windows.net
# CAREER_AZURE_STORAGE_ACCOUNT_NAME=career
# CAREER_AZURE_STORAGE_CREDENTIAL=managed_identity
# CAREER_AZURE_STORAGE_PREFIX=prod/
#
# Azure Blob — account key or SAS credential:
# CAREER_CLOUD_PROFILE=azure
# CAREER_OBJECT_STORAGE_BACKEND=azure_blob
# CAREER_AZURE_STORAGE_CONTAINER=career-data
# CAREER_AZURE_STORAGE_ACCOUNT_URL=https://career.blob.core.windows.net
# CAREER_AZURE_STORAGE_ACCOUNT_NAME=career
# CAREER_AZURE_STORAGE_CREDENTIAL=...
# CAREER_AZURE_STORAGE_PREFIX=prod/

# --- Backups (ADR-0063) -------------------------------------------------------
# scripts/backup.sh reads these. BACKUP_REMOTE makes every run off-host (T1
# requires it; a local-only install must be labelled non-DR). Encrypt when
# the destination is shared (age public key; the key never travels with the
# archive).
# BACKUP_REMOTE=s3://my-bucket/career/backups
# BACKUP_REMOTE=rclone:myremote:career/backups
# BACKUP_AGE_RECIPIENT=age1...

# --- Optional: TLS reverse proxy (--profile proxy) --------------------------
# The public hostname pointing at this machine (A/AAAA record).
# CA_DOMAIN=career.example.com
