{
  "apiVersion": "extension/v1",
  "kindVersion": 1,
  "kind": "connector",
  "id": "career-rss",
  "version": "1.0.0",
  "description": "Postings from an RSS 2.0 or Atom job feed.",
  "author": "Neuronection",
  "license": "Apache-2.0",
  "capabilities": [
    "sync"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "Feed URL",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required": [
      "url"
    ]
  },
  "itemSchema": {
    "type": "object",
    "properties": {
      "external_id": {
        "type": "string",
        "title": "External id"
      },
      "title": {
        "type": "string",
        "title": "Title"
      },
      "url": {
        "type": "string",
        "title": "URL"
      }
    },
    "required": [
      "external_id",
      "title"
    ]
  },
  "supportsIncremental": true,
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "title": "RSS / Atom feed",
        "summary": "Job postings from any RSS 2.0 or Atom feed."
      }
    }
  },
  "repository": "https://github.com/neuronection/career-assistant",
  "categories": [
    "search"
  ],
  "docs": "docs/docs-tree.json"
}
